{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "watchPatterns": [
      "package.json",
      "package-lock.json",
      "railway.json",
      "server.js",
      "src/**",
      "public/**"
    ]
  },
  "deploy": {
    "startCommand": "npm start",
    "numReplicas": 1,
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 60,
    "sleepApplication": true,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3,
    "cronSchedule": null,
    "overlapSeconds": 0,
    "drainingSeconds": 10
  }
}
